FROM paper-timesfm:research-v1
COPY deploy/requirements-service.lock /tmp/requirements-service.txt
RUN pip install --no-cache-dir -r /tmp/requirements-service.txt
COPY src /app/src
COPY architect/06_contracts /app/contracts
COPY deploy/reference-calendar.json /app/reference-calendar.json
USER 10001:10001
CMD ["python", "-m", "src.operations.worker"]
