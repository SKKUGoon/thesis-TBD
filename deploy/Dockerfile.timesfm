FROM python:3.12-slim-bookworm

RUN apt-get update && apt-get install -y --no-install-recommends git ca-certificates \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY deploy/requirements-timesfm.txt /tmp/requirements-timesfm.txt
RUN pip install --no-cache-dir -r /tmp/requirements-timesfm.txt
COPY src /app/src
ENV PYTHONPATH=/app PYTHONUNBUFFERED=1 HF_HUB_OFFLINE=1 OMP_NUM_THREADS=2
CMD ["python", "-m", "src.operations.inference", "--checkpoint", "/model", "--output", "/results/linux_preflight.json"]
